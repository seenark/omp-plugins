{
	"name": "@codesook/omp-headroom",
	"version": "2.0.0",
	"type": "module",
	"description": "Headroom context compression bridge for oh-my-pi",
	"license": "MIT",
	"scripts": {
		"check:types": "tsc -p tsconfig.json --noEmit",
		"test": "bun test",
	"pack:check": "bun ../../scripts/check-package-files.ts"
	},
	"files": [
		"index.ts",
		"types.ts",
		"config.ts",
		"display.ts",
		"init.ts",
		"bridge.ts",
		"client.ts",
		"README.md"
	],
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=18.2.8",
		"@oh-my-pi/pi-tui": ">=18.2.8",
		"@oh-my-pi/pi-ai": ">=18.2.8"
	},
	"dependencies": {
		"@codesook/omp-shared-display": "^1.0.0"
	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "18.2.8",
		"@oh-my-pi/pi-tui": "18.2.8",
		"@oh-my-pi/pi-ai": "18.2.8",
		"@codesook/omp-shared-display": "workspace:*",
		"bun-types": "latest",
		"typescript": "latest"
	},
	"omp": { "extensions": ["./index.ts"] },
	"publishConfig": { "access": "public" }
