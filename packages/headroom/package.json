	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=16.1.7",
		"@oh-my-pi/pi-tui": ">=16.1.7",
		"@oh-my-pi/pi-ai": ">=16.1.7",
		"bun-types": "latest",
		"typescript": "latest"
	},
	"omp": { "extensions": ["./index.ts"] },
