{
  "name": "@codesook/omp-plugin-settings",
  "version": "1.0.0",
  "type": "module",
  "description": "Unified Codesook OMP plugin settings for oh-my-pi",
  "license": "MIT",
  "files": [
    "index.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "check:types": "tsc -p tsconfig.json --noEmit",
    "pack:check": "bun ../../scripts/check-package-files.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "dependencies": {
    "@codesook/omp-caveman": "^1.0.0",
    "@codesook/omp-headroom": "^2.0.0",
    "@codesook/omp-prompt-border-style": "^2.0.0",
    "@codesook/omp-shared-display": "^1.0.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.3.1",
    "@oh-my-pi/pi-tui": ">=18.3.1"
  },
  "devDependencies": {
    "@codesook/omp-caveman": "workspace:*",
    "@codesook/omp-headroom": "workspace:*",
    "@codesook/omp-prompt-border-style": "workspace:*",
    "@codesook/omp-shared-display": "workspace:*",
    "@oh-my-pi/pi-coding-agent": "18.3.1",
    "@oh-my-pi/pi-tui": "18.3.1",
    "bun-types": "latest",
    "typescript": "latest"
  },
  "omp": {
    "extensions": ["./index.ts"]
  },
  "publishConfig": {
    "access": "public"
  }
}
