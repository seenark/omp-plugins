{
	"name": "@codesook/omp-pstack",
	"version": "1.0.0",
	"type": "module",
	"description": "pstack workflows (poteto-mode, playbooks, principles) for oh-my-pi",
	"license": "MIT",
	"files": [
		"src",
		"skills",
		"agents",
		"rules",
		"README.md",
		"THIRD-PARTY-NOTICES.txt"
	],
	"scripts": {
