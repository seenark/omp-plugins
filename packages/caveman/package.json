	},
	"devDependencies": {
		"@codesook/omp-shared-display": "workspace:*",
		"@oh-my-pi/pi-coding-agent": "18.2.8",
		"@oh-my-pi/pi-tui": "18.2.8",
		"bun-types": "latest",
		"typescript": "latest"
	},
	"omp": {
		"extensions": ["./src/index.ts"]
	},
	"publishConfig": {
		"access": "public"
	}
