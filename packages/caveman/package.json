	},
	"exports": {
		".": "./src/index.ts"
	},
	"dependencies": {
		"@codesook/omp-shared-display": "^1.0.0"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=18.2.8",
