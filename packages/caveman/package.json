{
	"name": "@codesook/omp-caveman",
	"version": "1.0.0",
	"type": "module",
	"description": "Canonical Caveman mode and Shared Display producer for oh-my-pi",
	"license": "MIT",
	"files": [
		"src",
		"skills",
		"assets",
		"README.md",
		"THIRD-PARTY-NOTICES.txt"
	],
	"scripts": {
		"check:types": "tsc -p tsconfig.json --noEmit",
