{
  "name": "@codesook/omp-shared-display",
  "version": "1.0.0",
  "type": "module",
  "description": "Opt-in shared status display host and EventBus client for oh-my-pi",
  "license": "MIT",
  "files": [
    "src/index.ts",
    "src/client.ts",
    "src/config-store.ts",
    "assets",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "pack:check": "bun ../../scripts/check-package-files.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./config-store": "./src/config-store.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.2.8",
    "@oh-my-pi/pi-tui": ">=18.2.8"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.2.8",
    "@oh-my-pi/pi-tui": "18.2.8",
    "bun-types": "latest",
    "typescript": "latest"
  },
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "publishConfig": {
    "access": "public"
  }
}
