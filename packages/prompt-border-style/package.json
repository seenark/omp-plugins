{
    "name": "@codesook/omp-prompt-border-style",
    "version": "1.0.1",
    "type": "module",
    "description": "Prompt input border styles for oh-my-pi",
    "license": "MIT",
    "files": [
        "src/main.ts",
        "README.md",
        "assets"
    ],
    "scripts": {
        "check": "bun --bun tsc --noEmit",
        "check:types": "bun --bun tsc --noEmit",
        "test": "bun test src/main.test.ts",
        "lint": "bun --bun tsc --noEmit",
        "build": "bun --bun tsc --noEmit",
        "pack:check": "bun pm pack --dry-run --quiet"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@oh-my-pi/pi-coding-agent": ">=18.0.3",
        "@oh-my-pi/pi-tui": ">=18.0.3"
    },
    "devDependencies": {
        "@oh-my-pi/pi-coding-agent": ">=18.0.3",
        "@oh-my-pi/pi-tui": ">=18.0.3",
        "bun-types": "latest",
        "typescript": "latest"
    },
    "omp": {
        "extensions": [
            "./src/main.ts"
        ]
    }
}
