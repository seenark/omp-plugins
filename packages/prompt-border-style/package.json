{
    "name": "@codesook/omp-prompt-border-style",
    "version": "2.0.0",
    "type": "module",
    "description": "Prompt input border styles for oh-my-pi",
    "license": "MIT",
    "files": [
        "src/main.ts",
        "src/context-rail.ts",
        "README.md",
        "assets"
    ],
    "scripts": {
        "check": "bun --bun tsc --noEmit",
        "check:types": "tsc -p tsconfig.json --noEmit",
        "test": "bun test src/context-rail.test.ts src/main.test.ts",
        "lint": "bun --bun tsc --noEmit",
        "build": "bun --bun tsc --noEmit",
        "pack:check": "bun ../../scripts/check-package-files.ts"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@oh-my-pi/pi-coding-agent": ">=18.1.16",
        "@oh-my-pi/pi-tui": ">=18.1.16"
    },
    "dependencies": {
        "@codesook/omp-shared-display": "^1.0.0"
    },
    "devDependencies": {
        "@codesook/omp-shared-display": "workspace:*",
        "@oh-my-pi/pi-coding-agent": "18.1.16",
        "@oh-my-pi/pi-tui": "18.1.16",
        "bun-types": "latest",
        "typescript": "latest"
    },
    "omp": {
        "extensions": [
            "./src/main.ts"
        ]
    }
}
