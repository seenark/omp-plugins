{
  "name": "omp-plugins",
  "version": "0.2.0",
  "private": true,
  "description": "Monorepo for standalone oh-my-pi plugins installable from GitHub or publishable as separate packages.",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "list": "bun pm ls --all",
    "check": "bun run scripts/check-workspace.mjs",
    "check:sync": "bun run --workspaces --if-present check:sync",
    "typecheck": "bun run --workspaces --if-present check:types",
    "test": "bun run --workspaces --sequential --if-present test",
    "pack:check": "bun run --workspaces --if-present pack:check",
    "build:release": "bun run --cwd packages/pstack build:release",
    "verify": "bun run typecheck && bun run test && bun run check && bun run check:sync && bun run pack:check",
    "hooks:install": "lefthook install"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.2.8",
    "@oh-my-pi/pi-coding-agent": ">=18.3.1",
    "@oh-my-pi/pi-tui": ">=18.3.1"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "omp": {
    "extensions": [
      "./packages/codesook-omp-plugin/index.ts"
    ],
    "features": {
      "headroom": {
        "description": "Headroom context compression extension.",
        "default": true,
        "extensions": [
          "./packages/headroom/index.ts"
        ]
      },
      "prompt-border-style": {
        "description": "Prompt editor border styles extension.",
        "default": true,
        "extensions": [
          "./packages/prompt-border-style/src/main.ts"
        ]
      },
      "shared-display": {
        "description": "Shared animated status display host.",
        "default": false,
        "extensions": [
          "./packages/shared-display/src/index.ts"
        ]
      },
      "ponytail": {
        "description": "Canonical Ponytail instruction mode.",
        "default": false,
        "extensions": [
          "./packages/ponytail/src/index.ts"
        ]
      },
      "caveman": {
        "description": "Canonical Caveman instruction mode.",
        "default": false,
        "extensions": [
          "./packages/caveman/src/index.ts"
        ]
      },
      "codegraph": {
        "description": "Use initialized CodeGraph projects through configured MCP tools.",
        "default": false,
        "extensions": [
          "./packages/codegraph/src/index.ts"
        ]
      },
      "beads": {
        "description": "On-demand Beads guidance for usable initialized workspaces.",
        "default": false,
        "extensions": [
          "./packages/beads/src/index.ts"
        ]
      },
      "rtk": {
        "description": "RTK shell output rewriting and RTK Savings display.",
        "default": false,
        "extensions": [
          "./packages/rtk/src/index.ts"
        ]
      },
      "process-monitor": {
        "description": "/procs dashboard for processes and ports OMP leaves running.",
        "default": false,
        "extensions": [
          "./packages/process-monitor/src/index.ts"
        ]
      }
    }
  },
  "devDependencies": {
    "lefthook": "2.2.2"
  }
}
